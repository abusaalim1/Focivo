<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- v1.3.0: share-card download on Android 9 and below (scoped storage needs no permission on 10+) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- v1.1.2: REMOVED QUERY_ALL_PACKAGES (Play Protect high-risk permission:
         Google Play policy treats installed-app inventory as personal/sensitive
         data). No feature lost — provably identical output by construction:
         the blocked-apps picker (InstalledAppsManager.getInstalledApps) only
         calls PackageManager.queryIntentActivities(MAIN/LAUNCHER), and
         EssentialAppsGuard's home-launcher check only queries MAIN/HOME —
         BOTH intents are declared in the <queries> block above, which Android
         11+ honors as equivalent visibility for those lookups (verified by
         ManifestPermissionAuditTest.blockedAppsPickerHasPackageVisibility).
         All other getApplicationInfo callsites are best-effort try/catch with
         fallbacks (FocusShieldService.friendlyAppName, LockInStartOverlay),
         and the remaining ones target only our own package. -->
    <!-- v1.1.2: REMOVED REQUEST_INSTALL_PACKAGES (Play Protect high-risk
         permission: "install other apps" capability). No feature lost — the
         in-app updater never used PackageInstaller session APIs; it hands the
         downloaded APK to the SYSTEM installer via an ACTION_VIEW FileProvider
         intent (AppUpdateManager.installApk). The 1.3.5 canRequestPackageInstalls()
         pre-check was only a UX convenience; Android's own installer gate
         ("allow installs from this source") replaces it, with the existing
         browser fallback on any failure. Both the permission and the API call
         were removed together — never one without the other (the 1.3.3→1.3.5
         crash lesson). -->

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.twitter.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.reddit.frontpage" />
    </queries>

    <application
        android:name=".FocuslyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_small" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="focivo"
                    android:host="auth-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="regain"
                    android:host="auth-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="studytracker"
                    android:host="auth-callback" />
            </intent-filter>
            <!-- v1.3.0: Squads invite App Link — https://focivoapp.vercel.app/join/<code>
                 opens the app straight into the squad join screen (verified via
                 /.well-known/assetlinks.json). Custom-scheme fallback below. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="focivoapp.vercel.app"
                    android:pathPattern="/join/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="focivo"
                    android:host="join" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.screens.BlockedAppLockActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication"
            android:launchMode="singleInstance"
            android:taskAffinity="com.example.blocked.overlay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <service
            android:name=".service.FocusShieldService"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus shield app and distraction blocker during active focus sessions" />
        </service>

        <service
            android:name=".service.FocusTimerService"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus timer keeping the study session clock running in background" />
        </service>

        <receiver
            android:name=".service.ScheduledBlockReceiver$BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ScheduledBlockReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.action.SCHEDULE_TRANSITION" />
                <action android:name="com.example.action.SCHEDULE_BLOCK_START" />
                <action android:name="com.example.action.SCHEDULE_BLOCK_END" />
                <action android:name="com.example.action.SCHEDULE_REMINDER" />
                <action android:name="com.example.action.STRICT_LOCK_WARNING" />
                <action android:name="com.example.action.FOCUS_ALARM_RING" />
                <action android:name="com.example.action.DISMISS_ALARM" />
                <action android:name="com.example.action.SNOOZE_ALARM" />
            </intent-filter>
        </receiver>

        <!-- 1. Quick Study Timer Widget -->
        <receiver
            android:name=".widget.StudyTimerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_timer_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_study_timer_info" />
        </receiver>

        <!-- 2. Today's Schedule & Targets Widget -->
        <receiver
            android:name=".widget.TodayScheduleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_schedule_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_schedule_info" />
        </receiver>

        <!-- 3. Focus Shield & Deep Lock Widget -->
        <receiver
            android:name=".widget.FocusShieldWidgetProvider"
            android:exported="true"
            android:label="@string/widget_shield_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_focus_shield_info" />
        </receiver>

        <!-- 4. AI Study Coach & Zen Break Widget -->
        <receiver
            android:name=".widget.ZenStudyCoachWidgetProvider"
            android:exported="true"
            android:label="@string/widget_zen_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_zen_coach_info" />
        </receiver>

        <service
            android:name=".service.AiStudyAccessibilityService"
            android:label="Focivo AI Study Guard"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ai_study_accessibility_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Device Admin Receiver for Strict Mode uninstall protection (Feature 6) -->
        <receiver
            android:name=".service.FocivoDeviceAdminReceiver"
            android:label="Focivo Uninstall Protection"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
