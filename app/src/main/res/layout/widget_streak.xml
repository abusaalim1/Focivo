<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/fw_bg">

    <!-- soft lime glow behind mascot -->
    <ImageView android:layout_width="240dp" android:layout_height="240dp" android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-40dp" android:src="@drawable/fw_glow" android:importantForAccessibility="no"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="20dp">

        <!-- header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="8dp"
                android:src="@drawable/ic_widget_flame" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/tv_eyebrow" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Streak" android:textAllCaps="true"
                android:letterSpacing="0.16" android:textSize="10sp" android:fontFamily="@font/inter_medium"
                android:textColor="@color/fw_text_secondary"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="26dp"
                android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="12dp"
                android:background="@drawable/fw_pill">
                
                <TextView android:id="@+id/tv_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="On fire" android:textSize="11sp" android:fontFamily="@font/inter_medium"
                    android:textColor="@color/fw_accent"/>
            </LinearLayout>
        </LinearLayout>

        <!-- body -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="1 day streak" android:textSize="24sp" android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/fw_text_primary" android:letterSpacing="-0.02"/>
                <TextView android:id="@+id/tv_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Level 1 Student · 1 XP" android:textSize="11sp" android:fontFamily="@font/inter_regular"
                    android:textColor="@color/fw_text_tertiary" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tv_quote" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="“Every page studied today is a step towards your dream.”" android:textSize="14sp" android:fontFamily="@font/instrument_serif_italic"
                    android:textColor="@color/fw_text_secondary" android:layout_marginTop="10dp" android:maxLines="3" android:ellipsize="end"/>
            </LinearLayout>
            <ImageView android:id="@+id/iv_mascot" android:layout_width="104dp" android:layout_height="104dp"
                android:scaleType="fitCenter" android:src="@drawable/mascot_study_happy" android:contentDescription="Focivo mascot"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Today's goal"
                android:textSize="11sp" android:fontFamily="@font/inter_regular" android:textColor="@color/fw_text_secondary"/>
            <TextView android:id="@+id/tv_goal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 360 min"
                android:textSize="11sp" android:fontFamily="@font/inter_medium" android:textColor="@color/fw_text_primary"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pb_goal" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="4dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/fw_progress"/>
    </LinearLayout>
</FrameLayout>
