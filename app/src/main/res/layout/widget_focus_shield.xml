<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shield_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_v2_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: 3D shield tile + name + status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_shield_mascot"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_v2_icon_tile"
            android:contentDescription="Focus Shield"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic3d_shield" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.09"
                android:text="FOCUS SHIELD"
                android:textColor="@color/focivo_lime_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_shield_mode_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Distraction Blocker"
                android:textColor="@color/focivo_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_shield_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_v2_pill"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.06"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="ARMED"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Center: blocked apps stat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_v2_inner"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_shield_blocked_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="8 apps blocked"
            android:textColor="@color/focivo_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_shield_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Shorts and reels auto-intercept active"
            android:textColor="@color/focivo_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_toggle_shield"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_lime"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Arm Shield"
            android:textAllCaps="false"
            android:textColor="#FF10130E"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widget_btn_open_shield_hub"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_ghost"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Shield Hub"
            android:textAllCaps="false"
            android:textColor="@color/focivo_text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
