<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_v2_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: 3D icon tile + caption + status pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_timer_mascot"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_v2_icon_tile"
            android:contentDescription="Focivo Timer"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic3d_timer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.09"
                android:text="FOCUS TIMER"
                android:textColor="@color/focivo_lime_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_timer_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:text="Deep Work Session"
                android:textColor="@color/focivo_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_timer_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_v2_pill"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.06"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="READY"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Center: large time display + happy mascot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_v2_inner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_timer_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.05"
                android:text="25:00"
                android:textColor="@color/focivo_lime_primary"
                android:textSize="46sp" />

            <TextView
                android:id="@+id/widget_timer_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Tap to start a deep work session"
                android:textColor="@color/focivo_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_mascot_glow" />

            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:contentDescription="Focivo study mascot"
                android:src="@drawable/mascot_study_happy" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_quick_25"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_ghost"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="25 min"
            android:textAllCaps="false"
            android:textColor="@color/focivo_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_btn_quick_50"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_ghost"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="50 min"
            android:textAllCaps="false"
            android:textColor="@color/focivo_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_btn_open_timer"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1.2"
            android:background="@drawable/widget_v2_btn_lime"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Start"
            android:textAllCaps="false"
            android:textColor="#FF10130E"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
