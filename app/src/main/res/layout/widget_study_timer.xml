<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg_timer"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_timer_mascot"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Focivo Mascot"
            android:src="@drawable/mascot_studying" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.01"
                android:text="Focivo Focus"
                android:textColor="@color/focivo_text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/widget_timer_task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="1"
                android:text="Ready for Study Session"
                android:textColor="@color/focivo_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_timer_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_badge_lime"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3.5dp"
            android:text="READY"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Center Time Display in Frosted Glass Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_glass_inner_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_timer_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.03"
            android:text="25:00"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/widget_timer_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Tap to start a laser-focus study session ⚡"
            android:textColor="@color/focivo_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_quick_25"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_lime"
            android:fontFamily="@font/poppins_bold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⚡ 25m"
            android:textAllCaps="false"
            android:textColor="@color/focivo_near_black"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_btn_quick_50"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:fontFamily="@font/poppins_bold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🎯 50m"
            android:textAllCaps="false"
            android:textColor="@color/focivo_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_btn_open_timer"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_lime"
            android:fontFamily="@font/poppins_bold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="▶ Start"
            android:textAllCaps="false"
            android:textColor="@color/focivo_near_black"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
