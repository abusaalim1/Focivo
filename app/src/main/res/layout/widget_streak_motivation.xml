<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_v2_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: 3D flame tile + streak count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_streak_mascot"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_v2_icon_tile"
            android:contentDescription="Streak Flame"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic3d_flame" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_streak_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="12 day streak"
                android:textColor="@color/focivo_text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_streak_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Level 3 Student"
                android:textColor="@color/focivo_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_v2_pill"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.06"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="ON FIRE"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Center: motivational quote -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_v2_inner"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.09"
            android:text="TODAY'S SPARK"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_streak_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="2"
            android:text="Every page studied today is a step towards your dream."
            android:textColor="@color/focivo_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom: goal progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Today's study goal"
                android:textColor="@color/focivo_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_streak_goal_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="120 / 360 min"
                android:textColor="@color/focivo_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_streak_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="35"
            android:progressDrawable="@drawable/widget_v2_progress" />
    </LinearLayout>
</LinearLayout>
