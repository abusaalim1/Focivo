<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_zen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_v2_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: happy mascot + coach -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_zen_mascot"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_v2_icon_tile"
            android:contentDescription="Zen Coach Mascot"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/mascot_study_happy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.09"
                android:text="ZEN COACH"
                android:textColor="@color/focivo_lime_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_zen_user_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Level 3 · 1,240 XP"
                android:textColor="@color/focivo_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_zen_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_v2_pill"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.06"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="MINDFUL"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Center: coach tip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_v2_inner"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.09"
            android:text="TODAY'S TIP"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_zen_tip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="2"
            android:text="Clear your desk, take a sip of water, and conquer your next 25-minute target."
            android:textColor="@color/focivo_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_zen_break"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_lime"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="5m Zen Break"
            android:textAllCaps="false"
            android:textColor="#FF10130E"
            android:textSize="13sp" />

        <Button
            android:id="@+id/widget_btn_open_companion"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_ghost"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="AI Coach"
            android:textAllCaps="false"
            android:textColor="@color/focivo_text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
