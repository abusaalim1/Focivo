<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg_schedule"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_schedule_mascot"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Mascot"
            android:src="@drawable/mascot_studying" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.01"
                android:text="Today's Timetable"
                android:textColor="@color/focivo_text_primary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/widget_schedule_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Scheduled Study Blocks"
                android:textColor="@color/focivo_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_schedule_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_badge_purple"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.04"
            android:paddingStart="10dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3.5dp"
            android:text="SCHEDULE"
            android:textColor="@color/focivo_purple"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Center: Next Upcoming Target / Block Card in Frosted Glass Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_glass_inner_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_schedule_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0.02"
                android:text="🎯 NEXT TARGET"
                android:textColor="@color/focivo_lime_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_schedule_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:text="No scheduled blocks yet"
                android:textColor="@color/focivo_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_schedule_pending_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Tap to plan your study day"
                android:textColor="@color/focivo_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_open_schedule"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:fontFamily="@font/poppins_bold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="📅 Planner"
            android:textAllCaps="false"
            android:textColor="@color/focivo_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_btn_start_scheduled_block"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_lime"
            android:fontFamily="@font/poppins_bold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="▶ Study Now"
            android:textAllCaps="false"
            android:textColor="@color/focivo_near_black"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
