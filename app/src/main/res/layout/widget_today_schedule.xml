<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_v2_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: 3D calendar tile + timetable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_schedule_mascot"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_v2_icon_tile"
            android:contentDescription="Timetable"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic3d_calendar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="0.09"
                android:text="TODAY'S TIMETABLE"
                android:textColor="@color/focivo_lime_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_schedule_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Wed, Oct 14"
                android:textColor="@color/focivo_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_schedule_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_v2_pill"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.06"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="PLANNER"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Center: next target -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_v2_inner"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_schedule_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.09"
            android:text="NEXT TARGET · 50 MIN"
            android:textColor="@color/focivo_lime_primary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_schedule_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:text="Physics numericals"
            android:textColor="@color/focivo_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_schedule_pending_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/poppins_medium"
            android:text="4 tasks remaining for today"
            android:textColor="@color/focivo_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_open_schedule"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_ghost"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Planner"
            android:textAllCaps="false"
            android:textColor="@color/focivo_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_btn_start_scheduled_block"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_v2_btn_lime"
            android:fontFamily="@font/poppins_semibold"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Start Now"
            android:textAllCaps="false"
            android:textColor="#FF10130E"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
